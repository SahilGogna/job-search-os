# Copy this file to .env (or let scripts/init_env.py do it), then fill in the three
# values below. .env is gitignored and never read by Claude -- status comes only from
# scripts/check_connections.py, which prints `valid` / `invalid` / `missing` and never a
# value.
#
# Paste values bare, without quotes. Surrounding quotes are tolerated but unnecessary.

# Apify Console -> Settings -> API & Integrations -> create a new token -> paste it here.
APIFY_TOKEN=

# Do NOT paste your service-account JSON here.
#
# Keep the downloaded .json file OUTSIDE this repo -- a credentials file inside a git
# working tree can be committed by accident, which leaks the whole service account.
# Give Claude its absolute path instead and it runs:
#
#     scripts/set_env_value.py --key JSON_KEY_BASE_64 --from-file-base64 <path>
#
# which base64-encodes the whole file in-process. Base64 is the only supported encoding:
# it carries the literal \n sequences inside `private_key` through untouched, so there is
# nothing to escape, unescape, quote, or strip. If this line ever ends up holding raw
# JSON (starting with `{`), check_connections.py will say so and tell you the fix.
JSON_KEY_BASE_64=

# Your sheet URL looks like:
#     https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Copy the segment between /d/ and /edit.
SHEET_ID=
